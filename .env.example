# Copy to .env.local and fill in. This file is committed; .env.local is not.
# --- LLM (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Database (Neon: https://neon.tech) --- Part 1
DATABASE_URL=

# --- Notifications --- Part 8
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string. Also given to Telegram when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
REMINDER_EMAIL_TO=

# --- Google tools --- Part 7
# Places API (New) + Custom Search JSON API, from Google Cloud Console
# --- Fallback chat models (all free, none need a card) ---
# Each provider has its own quota, so adding keys here multiplies how much you
# can do in a day. Extra keys from the SAME provider do not help: Groq's limits
# are per-organization and Gemini's are per-project.
# Embeddings always stay on Gemini regardless of which chat model is selected,
# because vectors from two different models are not comparable.

# Step-by-step for all four: SETUP-MODELS.md
#
# console.groq.com — instant, every model supports tool use. Start here.
GROQ_API_KEY=
# cloud.cerebras.ai — 1M tokens/day, but free context stops at 8K
CEREBRAS_API_KEY=
# openrouter.ai — WARNING: its free endpoints only work with training and
# logging switched on, which cannot be turned off and kept. This assistant
# stores facts about your family. Leaving it unset is a reasonable choice.
OPENROUTER_API_KEY=
# console.mistral.ai — WARNING: the free Experiment tier trains on your data by
# default. Turn it off at Admin Console -> Privacy BEFORE creating the key, or
# leave it unset.
MISTRAL_API_KEY=

# Place search runs on OpenStreetMap (Overpass + Nominatim) and needs no key,
# so this is unused. Google Places was the original plan, but it requires a
# billing account with a card on file even inside the free allowance, and every
# other service here is keyless. Left in place only as a marker of that choice.
# GOOGLE_MAPS_API_KEY=
# Live web search. Optional: without it, Kayv still answers questions of fact,
# definition and history through Wikipedia, which needs no key at all. What a
# key buys is the half an encyclopedia cannot do — news, prices, what changed
# this week — and without one it says so rather than passing off an old article
# as current.
#
# tavily.com — 1,000 searches a month, resets monthly, no credit card.
#
# Google's Custom Search was the original choice and is not an option any more:
# it is closed to new customers and shuts down on 1 January 2027. Brave dropped
# its free tier in early 2026 and now wants a payment method.
TAVILY_API_KEY=

# Where "near me" means, as "lat,lng" — e.g. 16.8409,96.1735 for Yangon
HOME_LOCATION=

# Google Calendar, read-only. Single-user, so a long-lived refresh token
# obtained once beats building a full OAuth consent flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- App ---
# The single password guarding the whole app.
#
# Blank locally: localhost is not a public URL and a login screen every reload
# is friction with nothing behind it. REQUIRED in production — without it,
# anyone with the deployment URL can read and delete everything Kayv remembers
# about your family. /api/health reports ok:false and a WARNING if it is unset
# in production. See SETUP-DEPLOY.md.
APP_PASSWORD=

CRON_SECRET=
ASSISTANT_NAME=Kayv
OWNER_NAME=
TIMEZONE=Asia/Yangon
