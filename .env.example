# Copy to .env.local and fill in. This file is committed; .env.local is not.
# --- LLM (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Database (Neon: https://neon.tech) --- Part 1
DATABASE_URL=

# --- Notifications --- Part 8
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string. Also given to Telegram when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
REMINDER_EMAIL_TO=

# --- Google tools --- Part 7
# Places API (New) + Custom Search JSON API, from Google Cloud Console
# --- Fallback chat models (all free, none need a card) ---
# Each provider has its own quota, so adding keys here multiplies how much you
# can do in a day. Extra keys from the SAME provider do not help: Groq's limits
# are per-organization and Gemini's are per-project.
# Embeddings always stay on Gemini regardless of which chat model is selected,
# because vectors from two different models are not comparable.

# console.groq.com — instant, every model supports tool use
GROQ_API_KEY=
# cloud.cerebras.ai — 1M tokens/day, but free context stops at 8K
CEREBRAS_API_KEY=
# openrouter.ai — one key, many free models, auto-failover
OPENROUTER_API_KEY=
# console.mistral.ai — WARNING: the free Experiment tier trains on your data by
# default. Turn it off at Admin Console -> Privacy before using this key, or
# leave it unset. This assistant stores facts about your family.
MISTRAL_API_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Where "near me" means, as "lat,lng" — e.g. 16.8409,96.1735 for Yangon
HOME_LOCATION=

# Google Calendar, read-only. Single-user, so a long-lived refresh token
# obtained once beats building a full OAuth consent flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- App ---
CRON_SECRET=
ASSISTANT_NAME=Kayv
OWNER_NAME=
TIMEZONE=Asia/Yangon
