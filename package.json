{
  "name": "mylittlekayv",
  "version": "0.1.0",
  "private": true,
  "description": "A personal AI assistant with voice and text control, persistent memory, and proactive reminders.",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:local": "docker run -d --name mylittlekayv-postgres -e POSTGRES_PASSWORD=devpass -e POSTGRES_DB=kayv -p 55432:5432 pgvector/pgvector:pg17",
    "db:local:stop": "docker rm -f mylittlekayv-postgres",
    "db:migrate:local": "node scripts/migrate.mjs postgresql://postgres:devpass@localhost:55432/kayv",
    "telegram": "tsx scripts/telegram.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.550.0",
    "motion": "^12.0.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.0.0",
    "topojson-client": "^3.1.0",
    "tz-lookup": "^6.1.25",
    "world-atlas": "^2.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
