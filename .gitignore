# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
/drizzle/meta

# local scratch
/.scratch

# Every secret in one file, for pasting into a hosting dashboard. Never
# committed, and worth deleting once it has been used.
vercel-env.txt

# The Android signing key and its passwords. Losing the key means the app can
# never be updated in place again, so it is backed up — but never committed.
*.jks
*.keystore
keystore.properties

# Built apps, copied out of Gradle's build folder to be shared.
/release

# Crash reports the JVM writes into its working folder when a Gradle build
# runs out of memory. Useful for a minute, never worth keeping.
hs_err_pid*.log
replay_pid*.log

# Firebase service-account keys. They can send notifications as the project.
*firebase-adminsdk*.json
